# Pittsburgh Port Authority TrueTime API Key
# Get your free API key at: https://truetime.rideprt.org/
PAAC_API_KEY=your_api_key_here

# Bus Configuration
# Valid routes: 8, 13
# Stop number (for example 1009, 1016, 618, 733, 619, or 620)
BUS_ROUTE=13
STOP_ID=1009
STOP_NAME=Center Ave + Chalfonte Ave

# Optional: Custom port (default: 5001)
# API_PORT=5001

# Optional: CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5001,https://yourdomain.com

# The official static GTFS download is checked daily in the background.
# Override its URL here if PRT changes it. An empty value disables refresh.
# GTFS_STATIC_FEED_URL=https://rideprt.org/contentassets/1bda11b1f5f1408d8e8f99db6d5ebe75/gtfs.zip
